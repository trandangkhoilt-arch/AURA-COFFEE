# Cấu hình mẫu cho môi trường local. Dùng .dev.vars với Wrangler hoặc .env.local với Vite.
# Không commit các tệp này hoặc mật khẩu/khóa API thật vào Git.

ENVIRONMENT=development
DEFAULT_SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=500000

# Chatbot local ưu tiên Ollama. Đổi nếu Ollama chạy ở host/model khác.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Gemini là phương án dự phòng tùy chọn nếu Ollama không khả dụng.
# Đặt khóa thật trong .env.local, không commit lên Git.
GEMINI_API_KEY=

# Tài khoản Bootstrap Admin ban đầu (Chỉ sử dụng khi bảng users chưa có quản trị viên nào)
# Trong Production, hãy thiết lập bằng lệnh:
# npx wrangler secret put ADMIN_BOOTSTRAP_EMAIL
# npx wrangler secret put ADMIN_BOOTSTRAP_PASSWORD
ADMIN_BOOTSTRAP_EMAIL=admin@moccoffee.vn
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
